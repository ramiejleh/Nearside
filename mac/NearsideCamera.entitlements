<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Camera extensions must be sandboxed. It has no network: Nearside feeds it. -->
  <key>com.apple.security.app-sandbox</key><true/>
  <!-- Its Mach service name (CMIOExtensionMachServiceName) is under this group. -->
  <key>com.apple.security.application-groups</key>
  <array><string>X97D6QH7RS.dev.nearside.mac</string></array>
  <key>com.apple.application-identifier</key><string>X97D6QH7RS.dev.nearside.mac.camera</string>
  <key>com.apple.developer.team-identifier</key><string>X97D6QH7RS</string>
</dict>
</plist>
