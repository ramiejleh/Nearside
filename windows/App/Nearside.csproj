<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app: WinUI 3 (Windows App SDK, unpackaged), on the engine in NearsideBridge.dll
       (windows/Package.swift: build it first with `swift build` in windows/). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>Nearside</RootNamespace>
    <AssemblyName>Nearside</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Nearside.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The Swift build that has the bridge: debug unless set. -->
    <SwiftConfiguration Condition="'$(SwiftConfiguration)' == ''">debug</SwiftConfiguration>
    <!-- FFmpeg's shared build (LGPL) for this architecture: its bin folder's DLLs go next to the app. -->
    <FFmpegDir Condition="'$(FFmpegDir)' == ''">$(USERPROFILE)\deps\ffmpeg-n8.1-latest-winarm64-lgpl-shared-8.1</FFmpegDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\*.ico;Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\.build\$(SwiftConfiguration)\NearsideBridge.dll" Link="NearsideBridge.dll"
             CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\.build\$(SwiftConfiguration)\NearsideBridge.dll')" />
    <Content Include="$(FFmpegDir)\bin\*.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- The virtual camera (windows/Camera/build.cmd); the installer registers it (as an administrator). -->
    <Content Include="..\Camera\build\$(Platform.ToLowerInvariant())\NearsideCamera.dll" Link="NearsideCamera.dll"
             CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\Camera\build\$(Platform.ToLowerInvariant())\NearsideCamera.dll')" />
  </ItemGroup>
</Project>
