<Window
    x:Class="Nearside.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- First-run setup in its own window (the panel closes whenever you click elsewhere, which
         is most of the time during setup: you're busy on your phone). -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="36,40,36,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="56" Height="56" CornerRadius="12" Background="#1C1C1F">
                <Grid>
                    <Image x:Name="LogoImage" Width="56" Height="56" />
                    <FontIcon x:Name="PageIcon" FontSize="26" Foreground="White" Visibility="Collapsed" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="Bold" />
                <TextBlock x:Name="PageSubtitle" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Padding="36,18,36,18">
            <Grid>
                <!-- Welcome -->
                <StackPanel x:Name="WelcomePage" Spacing="14">
                    <Grid x:Name="Features" RowSpacing="14" />
                    <TextBlock x:Name="WelcomeNote" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="You need an Android 11+ phone on the same Wi-Fi as this PC. Nothing goes through the cloud." />
                </StackPanel>

                <!-- Prepare the phone -->
                <StackPanel x:Name="PhonePage" Spacing="14" Visibility="Collapsed">
                    <StackPanel x:Name="PhoneSteps" Spacing="14" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Keep your phone and PC on the same Wi-Fi. Wireless debugging stays on for that network after reboots." />
                </StackPanel>

                <!-- Pair -->
                <StackPanel x:Name="PairPage" Spacing="16" Visibility="Collapsed">
                    <StackPanel x:Name="PairInstruction" />
                    <StackPanel x:Name="QrCard" Spacing="10" HorizontalAlignment="Center">
                        <Border Width="192" Height="192" Padding="12" CornerRadius="14" Background="White">
                            <Grid>
                                <Image x:Name="QrImage" Stretch="Uniform" />
                                <ProgressRing x:Name="QrBusy" IsActive="False" Width="36" Height="36" />
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <ProgressRing x:Name="QrWaiting" IsActive="True" Width="12" Height="12" />
                            <TextBlock x:Name="QrStatus" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="CodeForm" Spacing="8" Visibility="Collapsed">
                        <TextBox x:Name="HostPortBox" Header="IP address and port" PlaceholderText="192.168.0.12:37123"
                                 FontFamily="Consolas" TextChanged="OnCodeChanged" />
                        <TextBox x:Name="CodeBox" Header="Pairing code" PlaceholderText="123456"
                                 FontFamily="Consolas" TextChanged="OnCodeChanged" />
                        <Button x:Name="PairButton" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}"
                                Click="OnPair" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing x:Name="PairBusy" IsActive="False" Width="14" Height="14" />
                                <TextBlock x:Name="PairButtonText" Text="Pair and set up" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border x:Name="StepsCard" Padding="12" CornerRadius="10" Visibility="Collapsed"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <StackPanel x:Name="StepList" Spacing="8" />
                    </Border>
                    <Grid>
                        <TextBlock Text="Keep your phone and PC on the same Wi-Fi." FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton x:Name="SwitchMethod" HorizontalAlignment="Right" FontSize="12" Click="OnSwitchMethod" />
                    </Grid>
                </StackPanel>

                <!-- Choices -->
                <StackPanel x:Name="ChoicesPage" Spacing="12" Visibility="Collapsed">
                    <local:Choice xmlns:local="using:Nearside" x:Name="MirrorChoice" Title="Mirror phone notifications"
                                  Text="Your phone's notifications appear on this PC. Dismiss, reply or click to open them on the phone." />
                    <local:Choice xmlns:local="using:Nearside" x:Name="TextsChoice" Title="Text messages"
                                  Text="Read and send SMS from the Messages window. RCS chats stay in Google Messages." />
                    <local:Choice xmlns:local="using:Nearside" x:Name="LoginChoice" Title="Start at sign-in"
                                  Text="Start Nearside when you sign in to Windows, so syncing is always on." />
                    <local:Choice xmlns:local="using:Nearside" x:Name="ToastChoice" Title="Hide &#x201C;pasted from your clipboard&#x201D; messages"
                                  Text="Android shows &#x201C;Shell pasted from your clipboard&#x201D; each time Nearside picks up something you copied. This is Android's own switch (Settings, Privacy, Show clipboard access) and it applies to every app: with it off, you also won't see when other apps read your clipboard." />
                </StackPanel>

                <!-- Done -->
                <Grid x:Name="DonePage" RowSpacing="14" Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="24,14" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <StackPanel x:Name="Dots" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="Back" Click="OnBack" MinWidth="80" />
                <Button x:Name="NextButton" Style="{ThemeResource AccentButtonStyle}" Click="OnNext" MinWidth="110" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
