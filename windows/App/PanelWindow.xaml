<Window
    x:Class="Nearside.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nearside">

    <!-- The panel the tray icon opens: the phone, what's moving between it and this PC, and the
         clipboard history. Files dropped anywhere on it go to the phone. -->
    <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Who and how the phone is, then what you can do. -->
        <StackPanel Padding="14,12,14,10" Spacing="10" BorderThickness="0,0,0,1"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="LogoImage" Width="26" Height="26" />
                <TextBlock Grid.Column="1" Text="Nearside" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Grid.Column="2" CornerRadius="11" Padding="9,3,9,4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" FontSize="12" MaxWidth="170" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock x:Name="BatteryText" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PhoneButton" HorizontalAlignment="Stretch" Click="OnPhone"
                        ToolTipService.ToolTip="Open a phone app on this PC">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xED35;" FontSize="13" />
                        <TextBlock Text="Apps" FontSize="12.5" />
                    </StackPanel>
                </Button>
                <Button x:Name="SendFilesButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnSendFiles"
                        ToolTipService.ToolTip="Send files to your phone (or drop them here)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE724;" FontSize="13" />
                        <TextBlock Text="Send files" FontSize="12.5" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" HorizontalAlignment="Stretch" Click="OnSettings">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE713;" FontSize="13" />
                        <TextBlock Text="Settings" FontSize="12.5" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Not set up yet. -->
        <StackPanel x:Name="SetupPrompt" Grid.Row="1" Spacing="10" VerticalAlignment="Center" Padding="32,0" Visibility="Collapsed">
            <FontIcon Glyph="&#xE8EA;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Connect your Android phone" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="A one-time setup of about two minutes. Afterwards everything syncs on its own."
                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="Set up Nearside" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Center" Click="OnSetUp" />
        </StackPanel>

        <!-- Set up: banners, transfers, then the history. -->
        <Grid x:Name="Main" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Padding="10,10,10,0" Spacing="8">
                <InfoBar x:Name="InUseBar" Severity="Informational" IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button Content="Use on this PC" Click="OnUseHere" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Name="ProblemBar" Severity="Warning" IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button x:Name="ReinstallButton" Content="Reinstall…" Click="OnReinstall" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <ItemsControl x:Name="TransferList" Grid.Row="1" Margin="10,8,10,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:TransferRow">
                        <Grid Padding="10,8" Margin="0,0,0,4" ColumnSpacing="10" CornerRadius="6"
                              Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Status}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ProgressBar IsIndeterminate="True" Margin="0,4,0,0" Visibility="{x:Bind InProgressVisibility}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button Content="Show" Visibility="{x:Bind ShowVisibility}" Click="OnShowTransfer" Tag="{x:Bind Id}" />
                                <Button Visibility="{x:Bind DismissVisibility}" Click="OnDismissTransfer" Tag="{x:Bind Id}"
                                        Style="{ThemeResource SubtleButtonStyle}" ToolTipService.ToolTip="Dismiss">
                                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="2" Padding="12,10,12,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="Search history" TextChanged="OnSearch" />
                <ComboBox x:Name="FilterBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnFilter" MinWidth="104">
                    <x:String>All</x:String>
                    <x:String>This PC</x:String>
                    <x:String>Phone</x:String>
                </ComboBox>
            </Grid>

            <ListView x:Name="HistoryList" Grid.Row="3" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="OnClipClick" Padding="4,0,4,4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ClipRow">
                        <Grid Padding="2,8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Copy to PC and phone" Click="OnUseClip" Tag="{x:Bind Id}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Delete" Click="OnDeleteClip" Tag="{x:Bind Id}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Border Width="26" Height="26" CornerRadius="13" VerticalAlignment="Top"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{x:Bind Preview}" FontSize="12.5" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border CornerRadius="7" Padding="5,0,5,1" Visibility="{x:Bind NewVisibility}"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="New" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Meta}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyHistory" Grid.Row="3" VerticalAlignment="Center" Spacing="6" Padding="32,0">
                <TextBlock x:Name="EmptyTitle" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyText" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid Grid.Row="4" Padding="14,6,8,8" BorderThickness="0,1,0,0"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <TextBlock x:Name="FooterText" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="ClearButton" HorizontalAlignment="Right" Style="{ThemeResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                        <TextBlock Text="Clear" FontSize="12" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="ClearFlyout">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="ClearQuestion" FontSize="13" />
                                <Button Content="Clear all" Style="{ThemeResource AccentButtonStyle}" Click="OnClearAll" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Grid>

        <!-- Shown while files are dragged over the panel. -->
        <Grid x:Name="DropOverlay" Grid.RowSpan="2" Visibility="Collapsed"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Rectangle x:Name="DropBorder" Margin="14" RadiusX="14" RadiusY="14" StrokeThickness="2" StrokeDashArray="4,3" />
            <StackPanel VerticalAlignment="Center" Spacing="8" Padding="24,0">
                <FontIcon x:Name="DropIcon" Glyph="&#xE898;" FontSize="34" />
                <TextBlock x:Name="DropTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock x:Name="DropText" Text="Files land in Download/Nearside on the phone." FontSize="12"
                           HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
