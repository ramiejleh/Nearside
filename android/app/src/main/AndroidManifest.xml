<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Granted once over ADB by the Mac during setup; lets the app re-enable wireless debugging. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Lets notification mirroring show each app's name and icon (Android 11 package visibility). -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- "Received from your Mac" for files; granted by the Mac over adb. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- SMS in the Mac's Messages window; granted by the Mac over adb. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:allowBackup="false"
        android:label="Nearside PoC"
        android:theme="@android:style/Theme.DeviceDefault">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Send to Mac" in the share sheet. -->
        <!-- Home screen of the Mac's phone window; only the shell (our helper) holds this permission. -->
        <activity
            android:name=".phone.HomeActivity"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:excludeFromRecents="true"
            android:taskAffinity="dev.nearside.phonehome"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Send to Mac"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Probe (removed with the probes): a text field that logs the keys it gets. -->
        <activity android:name=".helper.probe.KeyTestActivity" android:exported="true" />
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- "Stop" on the apps-open-on-your-Mac notification. -->
        <receiver
            android:name=".phone.InUseNotification$StopReceiver"
            android:exported="false" />

        <!-- Thaws the app so queued helper calls run; see link/WakeReceiver. -->
        <receiver
            android:name=".link.WakeReceiver"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL">
            <intent-filter>
                <action android:name="dev.nearside.WAKE" />
            </intent-filter>
        </receiver>

        <!-- Access is granted by the Mac over adb; see NotificationMirror. -->
        <service
            android:name=".NotificationMirror"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          The helper (shell uid) calls this once to hand the app its Binder (Shizuku-style).
          Only shell may call: INTERACT_ACROSS_USERS_FULL is signature|installer|... which shell
          holds and third-party apps can't get, and call() also checks the calling uid.
        -->
        <provider
            android:name=".link.HelperLinkProvider"
            android:authorities="dev.nearside.link"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
